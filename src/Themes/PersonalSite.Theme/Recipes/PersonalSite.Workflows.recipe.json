{
  "name": "PersonalSite.Workflows",
  "displayName": "Personal Site - Workflows",
  "description": "Workflow definitions for RSVP processing.",
  "author": "Krisztian Nemeth",
  "website": "https://markbartha.com",
  "version": "1.0",
  "categories": [],
  "tags": [],
  "steps": [
    {
      "name": "WorkflowType",
      "data": [
        {
          "WorkflowTypeId": "4rsvpworkflowtypeid0000000",
          "Name": "RSVP Submission",
          "IsEnabled": true,
          "IsSingleton": false,
          "LockTimeout": 0,
          "LockExpiration": 0,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "4rsvphttprequestactivity00",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 60,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "RSVP Submitted"
                },
                "HttpMethod": "POST",
                "Url": "/workflows/Invoke?token=replace-on-import",
                "ValidateAntiforgeryToken": false,
                "TokenLifeSpan": 0,
                "FormLocationKey": ""
              }
            },
            {
              "ActivityId": "4rsvpcreatecontenttask0000",
              "Name": "CreateContentTask",
              "X": 360,
              "Y": 60,
              "IsStart": false,
              "Properties": {
                "ContentType": "RsvpResponse",
                "Publish": true,
                "ContentProperties": {
                  "Expression": "{\"DisplayText\": \"RSVP from {{ Request.Form.email | default: '' | escape }}\", \"TitlePart\": {\"Title\": \"RSVP from {{ Request.Form.email | default: '' | escape }}\"}, \"ContainedPart\": {\"ListContentItemId\": \"4rsvpresponseslistitem0000\", \"ListContentType\": \"RsvpResponsesList\"}, \"RsvpResponse\": {\"Email\": {\"Text\": \"{{ Request.Form.email | default: '' | escape }}\"}, \"Attending\": {\"Text\": \"{{ Request.Form.attending | default: '' | escape }}\"}, \"GuestCount\": {\"Value\": {{ Request.Form.guestCount | default: 1 | plus: 0 }}}, \"GuestDetails\": {\"Text\": \"{{ Request.Form.guestDetails | default: '' | escape }}\"}, \"Message\": {\"Text\": \"{{ Request.Form.message | default: '' | escape }}\"}, \"SubmittedAt\": {\"Text\": \"{{ 'now' | date: '%Y-%m-%d %H:%M:%S' }}\"}}}"
                },
                "ActivityMetadata": {
                  "Title": "Create RSVP Response"
                }
              }
            },
            {
              "ActivityId": "4rsvpupdatecontenttask0000",
              "Name": "UpdateContentTask",
              "X": 690,
              "Y": 60,
              "IsStart": false,
              "Properties": {
                "Publish": true,
                "Content": {
                  "Expression": "'4rsvpresponseslistitem0000'"
                },
                "ContentProperties": {
                  "Expression": "{\"DisplayText\": \"RSVP Responses\", \"TitlePart\": {\"Title\": \"RSVP Responses\"}, \"RsvpResponsesList\": {\"LastSubmissionAt\": {\"Text\": \"{{ 'now' | date: '%Y-%m-%d %H:%M:%S' }}\"}, \"LastSubmissionBy\": {\"Text\": \"{{ Request.Form.email | default: '' | escape }}\"}}}"
                },
                "ActivityMetadata": {
                  "Title": "Update RSVP Collector"
                }
              }
            },
            {
              "ActivityId": "4rsvpredirecttask000000000",
              "Name": "HttpRedirectTask",
              "X": 1010,
              "Y": 60,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Redirect to RSVP"
                },
                "Location": {
                  "Expression": "/#rsvp"
                },
                "Permanent": false
              }
            }
          ],
          "Transitions": [
            {
              "Id": 0,
              "SourceActivityId": "4rsvphttprequestactivity00",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "4rsvpcreatecontenttask0000"
            },
            {
              "Id": 0,
              "SourceActivityId": "4rsvpcreatecontenttask0000",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "4rsvpupdatecontenttask0000"
            },
            {
              "Id": 0,
              "SourceActivityId": "4rsvpcreatecontenttask0000",
              "SourceOutcomeName": "Failed",
              "DestinationActivityId": "4rsvpredirecttask000000000"
            },
            {
              "Id": 0,
              "SourceActivityId": "4rsvpupdatecontenttask0000",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "4rsvpredirecttask000000000"
            },
            {
              "Id": 0,
              "SourceActivityId": "4rsvpupdatecontenttask0000",
              "SourceOutcomeName": "Failed",
              "DestinationActivityId": "4rsvpredirecttask000000000"
            }
          ],
          "Properties": {}
        }
      ]
    }
  ]
}
