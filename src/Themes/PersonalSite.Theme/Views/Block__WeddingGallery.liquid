{% assign heading = Model.ContentItem.Content.WeddingGallery.Heading.Text %}
{% assign caption = Model.ContentItem.Content.WeddingGallery.Caption.Text %}
{% assign gallery_items = Model.ContentItem.Content.Items.ContentItems %}

<section id="gallery" class="px-6 py-24 md:py-32">
    <div class="page-container">
        <div class="mx-auto max-w-4xl text-center">
            <h2 class="wedding-heading text-gold-light">{{ heading }}</h2>
        </div>

        {% if gallery_items and gallery_items.size > 0 %}
            <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for item in gallery_items %}
                    {{ item | shape_build_display: "Detail" | shape_render }}
                {% endfor %}
            </div>
        {% endif %}

        {% if caption != blank %}<p class="mt-8 text-center text-sm italic text-paper/70">{{ caption }}</p>{% endif %}
    </div>
</section>
