{% assign year = Model.ContentItem.Content.WeddingMilestone.Year.Text %}
{% assign title = Model.ContentItem.Content.WeddingMilestone.Title.Text %}
{% assign description = Model.ContentItem.Content.WeddingMilestone.Description.Text %}

<article class="card-compact card-hover">
    <p class="tag">{{ year }}</p>
    <h3 class="mt-3 font-display text-2xl uppercase tracking-widest text-gold-dark">{{ title }}</h3>
    <p class="mt-2 text-lg">{{ description }}</p>
</article>
