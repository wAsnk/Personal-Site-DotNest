{% assign title = Model.ContentItem.DisplayText %}
{% assign milestone_items = Model.ContentItem.Content.Milestones.ContentItems %}

<section class="section-shell">
    <div class="section-inner max-w-4xl">
        <div class="mb-20 text-center">
            <h2 class="section-heading">{{ title }}</h2>

            <svg viewBox="0 0 300 10" class="mx-auto mt-5 w-full max-w-xs" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
                <line x1="0" y1="5" x2="138" y2="5" class="theme-light:stroke-gold/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></line>
                <line x1="162" y1="5" x2="300" y2="5" class="theme-light:stroke-gold/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></line>
                <path d="M 140 3 L 142 5 L 140 7 L 138 5 Z" class="theme-light:fill-gold/25 theme-light:stroke-gold/40 theme-dark:fill-gold-light/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></path>
                <path d="M 150 2.5 L 152.5 5 L 150 7.5 L 147.5 5 Z" class="theme-light:fill-gold/40 theme-light:stroke-gold/60 theme-dark:fill-gold-light/60 theme-dark:stroke-gold-light/90" stroke-width="0.7"></path>
                <path d="M 160 3 L 162 5 L 160 7 L 158 5 Z" class="theme-light:fill-gold/25 theme-light:stroke-gold/40 theme-dark:fill-gold-light/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></path>
            </svg>
        </div>

        <div class="relative">
            <div class="timeline-line left-1/2 hidden -translate-x-1/2 md:block" aria-hidden="true"></div>
            <div class="timeline-line left-6 md:hidden" aria-hidden="true"></div>

            <div class="space-y-16 md:space-y-20">
                {% if milestone_items %}
                    {% for milestone_item in milestone_items %}
                        {% assign milestone = milestone_item.OurStoryMilestone %}
                        {% assign milestone_year = milestone.Year.Text %}
                        {% assign milestone_title = milestone_item.DisplayText %}
                        {% assign milestone_description = milestone.Description.Text %}

                        {% if milestone_title != blank %}
                            {% assign side = forloop.index0 | modulo: 2 %}
                            {% assign content_class = "md:mr-auto md:w-[calc(50%-2rem)] md:pr-12 md:pl-0 md:text-right" %}
                            {% if side == 1 %}
                                {% assign content_class = "md:ml-auto md:w-[calc(50%-2rem)] md:pl-12 md:text-left" %}
                            {% endif %}

                            <div class="relative">
                                <div class="timeline-dot left-1/2 top-1 hidden -translate-x-1/2 md:block" aria-hidden="true"></div>
                                <div class="timeline-dot left-6 top-1 -translate-x-1/2 md:hidden" aria-hidden="true"></div>
                                <div class="pl-14 {{ content_class }}">
                                    {% if milestone_year != blank %}
                                        <p class="font-display text-sm uppercase tracking-[0.2em] theme-light:text-gold theme-dark:text-gold-light">{{ milestone_year }}</p>
                                    {% endif %}
                                    <h3 class="mt-2 font-display text-2xl font-normal uppercase tracking-[0.12em] theme-light:text-gold-dark theme-dark:text-gold-light">{{ milestone_title }}</h3>
                                    {% if milestone_description != blank %}
                                        <p class="section-body mt-3">{{ milestone_description }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
</section>
