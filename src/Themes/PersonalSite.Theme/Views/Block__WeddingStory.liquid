{% assign heading = Model.ContentItem.Content.WeddingStory.Heading.Text %}
{% assign intro = Model.ContentItem.Content.WeddingStory.Intro.Text %}
{% assign timeline_items = Model.ContentItem.Content.Timeline.ContentItems %}

<section id="story" class="px-6 py-24 md:py-32">
    <div class="page-container">
        <div class="mx-auto max-w-3xl">
            <h2 class="text-center wedding-heading text-gold-dark">{{ heading }}</h2>
            {% if intro != blank %}<p class="mx-auto mt-4 max-w-2xl text-center text-lg italic text-bronze/80">{{ intro }}</p>{% endif %}

            {% if timeline_items and timeline_items.size > 0 %}
                <div class="mt-12 space-y-10">
                    {% for item in timeline_items %}
                        {{ item | shape_build_display: "Detail" | shape_render }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>
