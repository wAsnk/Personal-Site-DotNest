{% assign couple_names = Model.ContentItem.Content.WeddingClosing.CoupleNames.Text %}
{% assign date_text = Model.ContentItem.Content.WeddingClosing.DateText.Text %}
{% assign location = Model.ContentItem.Content.WeddingClosing.Location.Text %}

<footer class="site-footer">
    <div class="page-container text-center">
        <h2 class="font-display text-3xl uppercase tracking-widest text-gold-dark md:text-4xl">{{ couple_names }}</h2>
        <p class="mt-3 font-display text-sm uppercase tracking-widest text-bronze/75">{{ date_text }}</p>
        <p class="mt-2 text-sm uppercase tracking-widest text-bronze/60">{{ location }}</p>
    </div>
</footer>
