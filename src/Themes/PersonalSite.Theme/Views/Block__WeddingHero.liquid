{% assign intro = Model.ContentItem.Content.WeddingHero.Intro.Text %}
{% assign bride_name = Model.ContentItem.Content.WeddingHero.BrideName.Text %}
{% assign groom_name = Model.ContentItem.Content.WeddingHero.GroomName.Text %}
{% assign date_text = Model.ContentItem.Content.WeddingHero.Date.Text %}
{% assign time_text = Model.ContentItem.Content.WeddingHero.Time.Text %}
{% assign city = Model.ContentItem.Content.WeddingHero.City.Text %}
{% assign country = Model.ContentItem.Content.WeddingHero.Country.Text %}
{% assign facts = Model.ContentItem.Content.Background.ContentItems %}

<section id="home" class="relative min-h-screen overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: linear-gradient(to bottom, rgba(30,28,22,0.5), rgba(30,28,22,0.82)), url('https://cdn.magicpatterns.com/uploads/7Q1BZdeJT94annecS5TuZq/IMG_1283.jpg');"></div>
    <div class="absolute inset-3 border border-gold-light/30"></div>

    <div class="relative z-10 flex min-h-screen items-center justify-center px-6 py-16 text-center">
        <div>
            <p class="font-display text-sm uppercase tracking-widest text-white/75">{{ intro }}</p>
            <h1 class="mt-10 font-display text-5xl uppercase tracking-widest text-gold-light sm:text-6xl md:text-7xl">{{ bride_name }}</h1>
            <p class="my-4 font-display text-2xl text-gold-light/90">&amp;</p>
            <h1 class="font-display text-5xl uppercase tracking-widest text-gold-light sm:text-6xl md:text-7xl">{{ groom_name }}</h1>
            <div class="mx-auto mt-10 h-px w-16 bg-gold-light/50"></div>
            <p class="mt-6 font-display text-xl uppercase tracking-widest text-gold-light">{{ date_text }}</p>
            <p class="mt-2 text-lg italic text-white/65">{{ time_text }}</p>
            <p class="mt-6 font-display text-base uppercase tracking-widest text-gold-light">{{ city }}</p>
            <p class="text-base italic text-white/60">{{ country }}</p>

            {% if facts and facts.size > 0 %}
                <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
                    {% for fact in facts %}
                        {{ fact | shape_build_display: "Detail" | shape_render }}
                    {% endfor %}
                </div>
            {% endif %}

            <div class="mt-10">
                <a class="btn btn-ghost-inverse btn-md" href="#rsvp">Respond</a>
            </div>
        </div>
    </div>
</section>
