<!doctype html>
<html lang="{{ Culture.Name }}" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{ "PageTitle" | shape_new | shape_stringify }}</title>

    {% resources type: "Meta" %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;700&family=EB+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    {% shape "Tailwind__Styles" %}

    {% resources type: "HeadScript" %}
    {% resources type: "HeadLink" %}
    {% resources type: "Stylesheet" %}
    {% render_section "HeadMeta", required: false %}
</head>

<body dir="{{ Culture.Dir }}" class="bg-paper text-bronze font-serif antialiased">
    <header class="site-nav">
        <div class="page-container py-4">
            <div class="flex items-center justify-between gap-6">
                <a href="{{ "~/" | href }}" class="font-cinzel text-sm uppercase tracking-widest text-gold-dark">{{ Site.SiteName }}</a>

                {% assign main_menu = Content["alias:main-menu"] %}
                {% assign menu_items = main_menu.Content.MenuItemsListPart.MenuItems %}

                <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
                    {% if menu_items %}
                        {% for item in menu_items %}
                            {% assign link_text = item.DisplayText %}
                            {% assign raw_url = item.LinkMenuItemPart.Url %}
                            {% assign link_url = raw_url %}
                            {% if raw_url %}
                                {% assign url_prefix = raw_url | slice: 0, 2 %}
                                {% if url_prefix == "~/" %}
                                    {% assign link_url = raw_url | href %}
                                {% endif %}
                            {% endif %}
                            {% assign link_target = item.LinkMenuItemPart.Target %}
                            <a class="nav-link" href="{{ link_url }}"{% if link_target %} target="{{ link_target }}"{% endif %}>{{ link_text }}</a>
                        {% endfor %}
                    {% endif %}
                </nav>

                <button type="button" class="rounded border border-gold/40 px-2 py-1 text-bronze md:hidden" data-menu-toggle aria-controls="mobile-menu" aria-expanded="false">
                    <span class="sr-only">Toggle menu</span>
                    <span data-menu-icon="open"><i data-lucide="menu" class="h-5 w-5" aria-hidden="true"></i></span>
                    <span data-menu-icon="close" class="hidden"><i data-lucide="x" class="h-5 w-5" aria-hidden="true"></i></span>
                </button>
            </div>

            <div id="mobile-menu" data-mobile-menu class="hidden border-t border-gold/20 pt-4 md:hidden">
                {% if menu_items %}
                    <div class="space-y-2">
                        {% for item in menu_items %}
                            {% assign link_text = item.DisplayText %}
                            {% assign raw_url = item.LinkMenuItemPart.Url %}
                            {% assign link_url = raw_url %}
                            {% if raw_url %}
                                {% assign url_prefix = raw_url | slice: 0, 2 %}
                                {% if url_prefix == "~/" %}
                                    {% assign link_url = raw_url | href %}
                                {% endif %}
                            {% endif %}
                            {% assign link_target = item.LinkMenuItemPart.Target %}
                            <a class="nav-link-mobile" href="{{ link_url }}"{% if link_target %} target="{{ link_target }}"{% endif %}>{{ link_text }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </header>

    <main id="top" class="pt-16 min-h-screen">
        {% render_section "Messages", required: false %}
        {% render_section "BeforeContent", required: false %}
        {% render_section "Content" %}
        {% render_section "AfterContent", required: false %}
    </main>

    {% if Model.ContentItem.ContentType != "WeddingPage" %}
        <footer class="site-footer">
            <div class="page-container text-center">
                <p class="font-cinzel text-[11px] uppercase tracking-[0.18em] text-bronze/70">{{ Site.SiteName }}</p>
            </div>
        </footer>
    {% endif %}

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();

        const mobileMenuToggle = document.querySelector('[data-menu-toggle]');
        const mobileMenu = document.querySelector('[data-mobile-menu]');

        if (mobileMenuToggle && mobileMenu) {
            const openIcon = mobileMenuToggle.querySelector('[data-menu-icon="open"]');
            const closeIcon = mobileMenuToggle.querySelector('[data-menu-icon="close"]');

            const setMobileMenuState = (isOpen) => {
                mobileMenuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                mobileMenu.classList.toggle('hidden', !isOpen);
                if (openIcon) openIcon.classList.toggle('hidden', isOpen);
                if (closeIcon) closeIcon.classList.toggle('hidden', !isOpen);
            };

            setMobileMenuState(false);
            mobileMenuToggle.addEventListener('click', () => {
                const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
                setMobileMenuState(!isOpen);
            });
        }
    </script>

    {% resources type: "FootScript" %}
</body>
</html>
