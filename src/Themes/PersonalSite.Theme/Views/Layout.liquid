<!doctype html>
<html lang="{{ Culture.Name }}" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{ "PageTitle" | shape_new | shape_stringify }}</title>

    {% resources type: "Meta" %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cinzel:wght@400;500;600&display=swap" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    {% shape "Tailwind__Styles" %}

    {% resources type: "HeadScript" %}
    {% resources type: "HeadLink" %}
    {% resources type: "Stylesheet" %}
    {% render_section "HeadMeta", required: false %}
</head>

<body id="page-top" dir="{{ Culture.Dir }}" class="bg-paper text-bronze font-serif antialiased">
    <div class="paper-texture" aria-hidden="true"></div>

    {% assign main_menu = Content["alias:main-menu"] %}
    {% assign menu_items = main_menu.Content.MenuItemsListPart.MenuItems %}

    <header class="fixed inset-x-0 top-0 z-50">
        <div class="page-container pt-4">
            <nav class="rounded-full border border-gold-light/35 bg-bronze/55 px-4 py-3 backdrop-blur-sm md:px-6" aria-label="Primary">
                <div class="flex items-center justify-between gap-4">
                    <a href="{{ "~/" | href }}" class="font-display text-sm uppercase tracking-[0.18em] text-gold-light md:text-base">
                        {{ Site.SiteName }}
                    </a>

                    <div class="hidden items-center gap-6 md:flex">
                        {% if menu_items %}
                            {% for item in menu_items %}
                                {% assign link_text = item.DisplayText %}
                                {% assign raw_url = item.LinkMenuItemPart.Url %}
                                {% assign link_url = raw_url %}
                                {% if raw_url %}
                                    {% assign url_prefix = raw_url | slice: 0, 2 %}
                                    {% if url_prefix == "~/" %}
                                        {% assign link_url = raw_url | href %}
                                    {% endif %}
                                {% endif %}
                                {% assign link_target = item.LinkMenuItemPart.Target %}
                                <a href="{{ link_url }}" class="font-display text-xs uppercase tracking-[0.18em] text-paper/80 transition-colors hover:text-gold-light"{% if link_target %} target="{{ link_target }}"{% endif %}>
                                    {{ link_text }}
                                </a>
                            {% endfor %}
                        {% endif %}
                    </div>

                    <button type="button" class="rounded-md p-2 text-gold-light md:hidden" data-menu-toggle aria-controls="mobile-menu" aria-expanded="false">
                        <span class="sr-only">Toggle menu</span>
                        <span data-menu-icon="open"><i data-lucide="menu" class="h-5 w-5" aria-hidden="true"></i></span>
                        <span data-menu-icon="close" class="hidden"><i data-lucide="x" class="h-5 w-5" aria-hidden="true"></i></span>
                    </button>
                </div>

                <div id="mobile-menu" data-mobile-menu class="hidden border-t border-gold-light/25 pt-4 md:hidden">
                    <div class="grid gap-3 pb-2">
                        {% if menu_items %}
                            {% for item in menu_items %}
                                {% assign link_text = item.DisplayText %}
                                {% assign raw_url = item.LinkMenuItemPart.Url %}
                                {% assign link_url = raw_url %}
                                {% if raw_url %}
                                    {% assign url_prefix = raw_url | slice: 0, 2 %}
                                    {% if url_prefix == "~/" %}
                                        {% assign link_url = raw_url | href %}
                                    {% endif %}
                                {% endif %}
                                {% assign link_target = item.LinkMenuItemPart.Target %}
                                <a href="{{ link_url }}" class="font-display text-xs uppercase tracking-[0.18em] text-paper/85"{% if link_target %} target="{{ link_target }}"{% endif %}>
                                    {{ link_text }}
                                </a>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main id="top" class="min-h-screen w-full overflow-x-hidden">
        {% render_section "Messages", required: false %}
        {% render_section "BeforeContent", required: false %}

        {% render_section "Content" %}

        {% render_section "AfterContent", required: false %}
    </main>

    <footer class="border-t border-gold/30 bg-paper py-16">
        <div class="page-container text-center">
            <h2 class="font-display text-3xl font-normal uppercase tracking-[0.18em] text-gold-dark md:text-4xl">Klara & Krisztian</h2>
            <p class="mt-4 font-display text-xs uppercase tracking-[0.18em] text-bronze/70">03 . 07 . 2027</p>
            <p class="mt-6 font-serif text-sm uppercase tracking-[0.12em] text-bronze/60">Budapest, Hungary</p>
        </div>
    </footer>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
    <script>
        (function () {
            const toggle = document.querySelector("[data-menu-toggle]");
            const menu = document.querySelector("[data-mobile-menu]");

            if (!toggle || !menu) {
                return;
            }

            const openIcon = toggle.querySelector('[data-menu-icon="open"]');
            const closeIcon = toggle.querySelector('[data-menu-icon="close"]');

            const setMenuState = (isOpen) => {
                toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                menu.classList.toggle("hidden", !isOpen);

                if (openIcon) {
                    openIcon.classList.toggle("hidden", isOpen);
                }

                if (closeIcon) {
                    closeIcon.classList.toggle("hidden", !isOpen);
                }
            };

            setMenuState(false);
            toggle.addEventListener("click", () => setMenuState(toggle.getAttribute("aria-expanded") !== "true"));
        })();
    </script>
    <script>
        (function () {
            const heroBackground = document.querySelector("[data-hero-bg]");
            const heroContent = document.querySelector("[data-hero-content]");
            const heroIndicator = document.querySelector("[data-hero-indicator]");

            if (!heroBackground) {
                return;
            }

            let ticking = false;

            const updateHero = () => {
                const scrollY = window.scrollY || 0;
                const opacity = Math.max(0, 1 - scrollY / 600);

                heroBackground.style.transform = `translateY(${scrollY * 0.15}px)`;

                if (heroContent) {
                    heroContent.style.opacity = opacity;
                }

                if (heroIndicator) {
                    heroIndicator.style.opacity = opacity;
                }

                ticking = false;
            };

            window.addEventListener("scroll", () => {
                if (ticking) {
                    return;
                }

                ticking = true;
                window.requestAnimationFrame(updateHero);
            }, { passive: true });
        })();
    </script>

    {% resources type: "FootScript" %}
</body>
</html>
