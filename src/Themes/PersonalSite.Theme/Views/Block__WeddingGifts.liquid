{% assign heading = Model.ContentItem.Content.WeddingGifts.Heading.Text %}
{% assign intro = Model.ContentItem.Content.WeddingGifts.Intro.Text %}
{% assign body = Model.ContentItem.Content.WeddingGifts.Body.Text %}

<section id="gifts" class="px-6 py-24 md:py-32">
    <div class="page-container">
        <div class="mx-auto max-w-2xl text-center">
            <h2 class="wedding-heading text-gold-light">{{ heading }}</h2>
            <div class="mt-6 flex justify-center"><i data-lucide="gift" class="h-5 w-5 text-gold-light" aria-hidden="true"></i></div>
            <p class="mx-auto mt-6 max-w-lg text-lg italic">{{ intro }}</p>
            <p class="mx-auto mt-6 max-w-md text-lg">{{ body }}</p>
        </div>
    </div>
</section>
