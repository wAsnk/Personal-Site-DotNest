{% assign title = Model.ContentItem.DisplayText %}
{% assign detail_items = Model.ContentItem.Content.Details.ContentItems %}

<section class="section-shell">
    <div class="section-inner max-w-2xl">
        <div class="mb-14 text-center">
            <h2 class="section-heading">{{ title }}</h2>

            <svg viewBox="0 0 300 10" class="mx-auto mt-5 w-full max-w-xs" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
                <line x1="0" y1="5" x2="138" y2="5" class="theme-light:stroke-gold/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></line>
                <line x1="162" y1="5" x2="300" y2="5" class="theme-light:stroke-gold/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></line>
                <path d="M 140 3 L 142 5 L 140 7 L 138 5 Z" class="theme-light:fill-gold/25 theme-light:stroke-gold/40 theme-dark:fill-gold-light/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></path>
                <path d="M 150 2.5 L 152.5 5 L 150 7.5 L 147.5 5 Z" class="theme-light:fill-gold/40 theme-light:stroke-gold/60 theme-dark:fill-gold-light/60 theme-dark:stroke-gold-light/90" stroke-width="0.7"></path>
                <path d="M 160 3 L 162 5 L 160 7 L 158 5 Z" class="theme-light:fill-gold/25 theme-light:stroke-gold/40 theme-dark:fill-gold-light/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></path>
            </svg>
        </div>

        <div class="section-card">
            <div class="space-y-12 text-center">
                {% if detail_items %}
                    {% for detail_item in detail_items %}
                        {% assign detail = detail_item.WhenWhereDetail %}
                        {% assign detail_title = detail_item.DisplayText %}
                        {% assign place_name = detail.PlaceName.Text %}
                        {% assign date_time = detail.DateTime.Text %}
                        {% assign address = detail.Address.Text %}
                        {% assign map_label = detail.MapLabel.Text %}
                        {% assign map_url = detail.MapUrl.Text %}

                        <div>
                            <h3 class="font-display text-2xl font-normal uppercase tracking-[0.12em] theme-light:text-gold-dark theme-dark:text-gold-light">{{ detail_title }}</h3>
                            {% if place_name != blank %}
                                <p class="section-body mt-3">{{ place_name }}</p>
                            {% endif %}
                            {% if date_time != blank %}
                                <p class="section-muted mt-1 not-italic">{{ date_time }}</p>
                            {% endif %}
                            {% if address != blank %}
                                <p class="section-muted mt-1 not-italic">{{ address }}</p>
                            {% endif %}
                            {% if map_url != blank and map_label != blank %}
                                <a class="map-link mt-4" href="{{ map_url }}" target="_blank" rel="noopener noreferrer">
                                    <i data-lucide="map-pin" class="h-4 w-4" aria-hidden="true"></i>
                                    {{ map_label }}
                                </a>
                            {% endif %}
                        </div>

                        {% unless forloop.last %}
                            <div class="flex justify-center" aria-hidden="true">
                                <div class="h-2 w-2 rotate-45 border theme-light:border-gold theme-light:bg-gold/25 theme-dark:border-gold-light theme-dark:bg-gold-light/35"></div>
                            </div>
                        {% endunless %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
</section>
