{% assign details = Model.ContentItem.Content.WhenWhereSection %}
{% assign heading = details.Heading.Text %}
{% assign ceremony_title = details.CeremonyTitle.Text %}
{% assign ceremony_venue = details.CeremonyVenue.Text %}
{% assign ceremony_datetime = details.CeremonyDateTime.Text %}
{% assign ceremony_address = details.CeremonyAddress.Text %}
{% assign ceremony_map_label = details.CeremonyMapLabel.Text %}
{% assign ceremony_map_url = details.CeremonyMapUrl.Text %}
{% assign reception_title = details.ReceptionTitle.Text %}
{% assign reception_venue = details.ReceptionVenue.Text %}
{% assign reception_address = details.ReceptionAddress.Text %}
{% assign reception_region = details.ReceptionRegion.Text %}
{% assign reception_map_label = details.ReceptionMapLabel.Text %}
{% assign reception_map_url = details.ReceptionMapUrl.Text %}
{% assign reception_note = details.ReceptionNote.Text %}

<section id="details" class="section-shell">
    <div class="section-inner max-w-2xl">
        <div class="mb-14 text-center">
            <h2 class="section-heading">{{ heading }}</h2>

            <svg viewBox="0 0 300 10" class="mx-auto mt-5 w-full max-w-xs" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
                <line x1="0" y1="5" x2="138" y2="5" class="theme-light:stroke-gold/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></line>
                <line x1="162" y1="5" x2="300" y2="5" class="theme-light:stroke-gold/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></line>
                <path d="M 140 3 L 142 5 L 140 7 L 138 5 Z" class="theme-light:fill-gold/25 theme-light:stroke-gold/40 theme-dark:fill-gold-light/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></path>
                <path d="M 150 2.5 L 152.5 5 L 150 7.5 L 147.5 5 Z" class="theme-light:fill-gold/40 theme-light:stroke-gold/60 theme-dark:fill-gold-light/60 theme-dark:stroke-gold-light/90" stroke-width="0.7"></path>
                <path d="M 160 3 L 162 5 L 160 7 L 158 5 Z" class="theme-light:fill-gold/25 theme-light:stroke-gold/40 theme-dark:fill-gold-light/40 theme-dark:stroke-gold-light/70" stroke-width="0.6"></path>
            </svg>
        </div>

        <div class="section-card">
            <div class="space-y-12 text-center">
                <div>
                    <h3 class="font-display text-2xl font-normal uppercase tracking-[0.12em] theme-light:text-gold-dark theme-dark:text-gold-light">{{ ceremony_title }}</h3>
                    <p class="section-body mt-3">{{ ceremony_venue }}</p>
                    <p class="section-muted mt-1 not-italic">{{ ceremony_datetime }}</p>
                    <p class="section-muted mt-1 not-italic">{{ ceremony_address }}</p>
                    <a class="map-link mt-4" href="{{ ceremony_map_url }}" target="_blank" rel="noopener noreferrer">
                        <i data-lucide="map-pin" class="h-4 w-4" aria-hidden="true"></i>
                        {{ ceremony_map_label }}
                    </a>
                </div>

                <div class="flex justify-center" aria-hidden="true">
                    <div class="h-2 w-2 rotate-45 border theme-light:border-gold theme-light:bg-gold/25 theme-dark:border-gold-light theme-dark:bg-gold-light/35"></div>
                </div>

                <div>
                    <h3 class="font-display text-2xl font-normal uppercase tracking-[0.12em] theme-light:text-gold-dark theme-dark:text-gold-light">{{ reception_title }}</h3>
                    <p class="section-body mt-3">{{ reception_venue }}</p>
                    <p class="section-muted mt-1 not-italic">{{ reception_address }}</p>
                    <p class="section-faint mt-1">{{ reception_region }}</p>
                    <a class="map-link mt-4" href="{{ reception_map_url }}" target="_blank" rel="noopener noreferrer">
                        <i data-lucide="map-pin" class="h-4 w-4" aria-hidden="true"></i>
                        {{ reception_map_label }}
                    </a>
                </div>

                <div class="flex justify-center" aria-hidden="true">
                    <div class="h-2 w-2 rotate-45 border theme-light:border-gold theme-light:bg-gold/25 theme-dark:border-gold-light theme-dark:bg-gold-light/35"></div>
                </div>

                <p class="section-body italic">{{ reception_note }}</p>
            </div>
        </div>
    </div>
</section>
